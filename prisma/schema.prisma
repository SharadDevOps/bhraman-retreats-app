generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Role values: GUEST, CONTENT_EDITOR, BOOKING_MANAGER, SUPER_ADMIN
// RetreatStatus values: DRAFT, PUBLISHED, SOLD_OUT, COMPLETED, CANCELLED
// BookingStatus values: PENDING, CONFIRMED, WAITLISTED, CANCELLED, REFUNDED
// PaymentStatus values: PENDING, PAID, FAILED, REFUNDED, PARTIALLY_REFUNDED
// (SQLite does not support Prisma enums; stored as strings.)

model User {
  id         String    @id @default(cuid())
  externalId String?   @unique
  email      String    @unique
  name       String?
  phone      String?
  role       String    @default("GUEST")
  bookings   Booking[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Retreat {
  id           String         @id @default(cuid())
  slug         String         @unique
  title        String
  edition      String?
  summary      String
  description  String
  location     String
  startDate    DateTime
  endDate      DateTime
  priceInPaise Int
  capacity     Int
  status       String         @default("DRAFT")
  heroImageUrl String?
  itinerary    ItineraryDay[]
  bookings     Booking[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model ItineraryDay {
  id          String  @id @default(cuid())
  retreatId   String
  retreat     Retreat @relation(fields: [retreatId], references: [id], onDelete: Cascade)
  dayNumber   Int
  element     String
  title       String
  description String?
  activities  String // JSON-encoded array (SQLite has no Json type)
  @@unique([retreatId, dayNumber])
}

model Booking {
  id            String   @id @default(cuid())
  reference     String   @unique
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  retreatId     String
  retreat       Retreat  @relation(fields: [retreatId], references: [id])
  guests        Int      @default(1)
  totalInPaise  Int
  status        String   @default("PENDING")
  paymentStatus String   @default("PENDING")
  dietaryNotes  String?
  healthNotes   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String // JSON-encoded (SQLite has no Json type)
  published Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model MediaAsset {
  id        String   @id @default(cuid())
  blobName  String   @unique
  url       String
  altText   String
  mimeType  String
  width     Int?
  height    Int?
  createdAt DateTime @default(now())
}
